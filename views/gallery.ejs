<%- include('partials/header') %>

<!-- Page Banner -->
<div class="page-banner">
  <div class="container">
    <h1 class="page-banner-title"><i class="fas fa-images me-2"></i>Галерея</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Главная</a></li>
        <li class="breadcrumb-item active">Галерея</li>
      </ol>
    </nav>
  </div>
</div>

<main class="py-5">
  <div class="container">

    <% if (folders.length > 0) { %>

    <p class="text-muted mb-4">Фотографии из новостей организации, сгруппированные по событиям. Нажмите на папку, чтобы посмотреть все фото.</p>

    <div class="gallery-grid">
      <% folders.forEach(function(folder, i) { %>
      <div class="gallery-folder" onclick="openLightbox(galleryFolders[<%= i %>].photos, 0, galleryFolders[<%= i %>].title)">
        <% if (folder.count > 1) { %>
        <div class="gallery-folder-stack"></div>
        <% } %>
        <div class="gallery-item">
          <img src="<%= folder.cover %>" alt="<%= folder.title %>" loading="lazy">
          <% if (folder.count > 1) { %>
          <div class="gallery-folder-count"><i class="fas fa-images"></i> <%= folder.count %></div>
          <% } %>
          <div class="gallery-item-overlay">
            <div class="gallery-item-info">
              <span class="gallery-item-category"><%= folder.category %></span>
              <p class="gallery-item-title"><%= folder.title %></p>
              <span class="gallery-item-date">
                <i class="fas fa-calendar me-1"></i>
                <%= new Date(folder.published_at).toLocaleDateString('ru-RU', {day:'numeric', month:'long', year:'numeric'}) %>
              </span>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <script>
      const galleryFolders = <%- JSON.stringify(folders.map(f => ({ title: f.title, photos: f.photos }))).replace(/</g, '\\u003c') %>;
    </script>

    <% } else { %>
    <div class="empty-state">
      <i class="fas fa-images fa-3x mb-3" style="color:var(--text-muted); opacity:0.4;"></i>
      <h4 style="color:var(--primary);">Фотографий пока нет</h4>
      <p class="text-muted">Фото появятся здесь после публикации новостей с изображениями.</p>
      <a href="/news" class="btn-region-detail mt-3 d-inline-flex">
        <i class="fas fa-newspaper me-2"></i> Перейти к новостям
      </a>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>
