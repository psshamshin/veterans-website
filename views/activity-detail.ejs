<%
  locals.activePage = 'activity';
%>
<%- include('partials/header') %>

<div class="page-banner">
  <div class="container">
    <h1 class="page-banner-title"><i class="fas fa-hands-helping me-2"></i><%= title %></h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Главная</a></li>
        <li class="breadcrumb-item"><a href="/activity">Деятельность</a></li>
        <li class="breadcrumb-item active"><%= title %></li>
      </ol>
    </nav>
  </div>
</div>

<main class="py-5">
  <div class="container">
    <% if (blocks.length === 0) { %>
    <div class="text-center py-5">
      <i class="fas fa-tools fa-3x mb-4" style="color:var(--primary); opacity:0.35;"></i>
      <h3 style="color:var(--primary);">Раздел находится в разработке</h3>
      <p class="text-muted mt-2">Материалы будут опубликованы в ближайшее время.</p>
      <a href="/activity" class="btn btn-outline-primary mt-3">
        <i class="fas fa-arrow-left me-2"></i>Вернуться к деятельности
      </a>
    </div>
    <% } else { %>
    <% blocks.forEach(function(block) { %>
      <% if (block.type === 'text') { %>
      <div class="activity-detail-text mb-4">
        <% (block.content || '').split(/\n\n+/).forEach(function(p) { %>
        <p><%= p %></p>
        <% }); %>
      </div>
      <% } else if (block.type === 'image') { %>
      <div class="activity-detail-image mb-4">
        <img src="<%= block.content %>" alt="" class="img-fluid rounded shadow">
      </div>
      <% } %>
    <% }); %>
    <div class="mt-4">
      <a href="/activity" class="btn btn-outline-primary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Вернуться к деятельности
      </a>
    </div>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

<style>
.activity-detail-text p {
  font-size: 1rem; line-height: 1.75; color: #111; margin-bottom: 1rem;
}
.activity-detail-image {
  text-align: center;
}
.activity-detail-image img {
  max-width: 860px; width: 100%;
}
</style>
