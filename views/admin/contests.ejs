<%
  locals.activePage = 'contests';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title"><i class="fas fa-trophy me-2"></i>Конкурсы и акции</h2>
</div>

<!-- Title + text -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0">Заголовок и текст блока</h5></div>
  <div class="admin-card-body">
    <form action="/admin/contests/text" method="POST">
      <div class="mb-3">
        <label class="form-label fw-medium">Заголовок</label>
        <input type="text" name="title" class="form-control" required value="<%= contestsTitle %>">
      </div>
      <div class="mb-3">
        <label class="form-label fw-medium">Текст (абзац)</label>
        <textarea name="text" class="form-control" rows="5"><%= contestsText %></textarea>
      </div>
      <button type="submit" class="btn btn-danger">
        <i class="fas fa-save me-1"></i>Сохранить
      </button>
    </form>
  </div>
</div>

<!-- Photos -->
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h5 class="mb-0">Мини-галерея (<%= photos.length %> / <%= maxPhotos %>)</h5>
  </div>
  <div class="admin-card-body">
    <% if (photos.length < maxPhotos) { %>
    <form action="/admin/contests/photos/new" method="POST" enctype="multipart/form-data" class="row g-3 align-items-end mb-4">
      <div class="col-md-8">
        <input type="file" name="image" class="form-control" accept="image/*" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-danger w-100">
          <i class="fas fa-upload me-1"></i>Добавить фото
        </button>
      </div>
    </form>
    <% } else { %>
    <p class="text-muted small mb-4">Достигнут лимит — <%= maxPhotos %> фотографий. Удалите одну, чтобы добавить другую.</p>
    <% } %>

    <% if (photos.length > 0) { %>
    <div class="row g-3">
      <% photos.forEach(p => { %>
      <div class="col-md-3 col-sm-4 col-6">
        <div class="position-relative">
          <img src="<%= p.image %>" alt="" class="img-fluid rounded" style="width:100%;height:120px;object-fit:cover">
          <form action="/admin/contests/photos/<%= p.id %>/delete" method="POST"
                onsubmit="return confirm('Удалить фото?')"
                class="position-absolute top-0 end-0 m-1">
            <button type="submit" class="btn btn-xs btn-outline-danger bg-white">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center p-4 text-muted">
      <i class="fas fa-images fa-2x mb-2"></i>
      <p class="mb-0">Фотографий пока нет</p>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/admin-layout-bottom') %>
