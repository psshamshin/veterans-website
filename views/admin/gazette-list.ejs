<%
  locals.activePage = 'gazette';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title"><i class="fas fa-newspaper me-2"></i>Газета «Ветеран»</h2>
</div>

<!-- New issue -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Новый выпуск</h5></div>
  <div class="admin-card-body">
    <form action="/admin/gazette/issues/new" method="POST" enctype="multipart/form-data" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label fw-medium">Название выпуска</label>
        <input type="text" name="title" class="form-control" required placeholder="Например: Выпуск №3, июнь 2026">
      </div>
      <div class="col-md-3">
        <label class="form-label fw-medium">Обложка (фото)</label>
        <input type="file" name="cover" class="form-control" accept="image/*" required>
      </div>
      <div class="col-md-3">
        <label class="form-label fw-medium">Файл выпуска (PDF)</label>
        <input type="file" name="file" class="form-control" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-danger w-100">
          <i class="fas fa-upload me-1"></i>Добавить
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Issues list -->
<div class="admin-card">
  <div class="admin-card-body p-0">
    <% if (issues.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-hover admin-table mb-0">
        <thead>
          <tr><th style="width:70px">Обложка</th><th>Выпуск</th><th>Дата</th><th style="width:120px">Действия</th></tr>
        </thead>
        <tbody>
          <% issues.forEach(issue => { %>
          <tr>
            <td>
              <% if (issue.cover) { %>
              <img src="<%= issue.cover %>" alt="" class="table-thumb">
              <% } %>
            </td>
            <td class="fw-medium"><%= issue.title %></td>
            <td class="text-muted small">
              <%= new Date(issue.created_at).toLocaleDateString('ru-RU') %>
            </td>
            <td>
              <div class="d-flex gap-1">
                <% if (issue.file) { %>
                <a href="<%= issue.file %>" target="_blank" class="btn btn-xs btn-outline-secondary" title="Открыть PDF">
                  <i class="fas fa-eye"></i>
                </a>
                <% } %>
                <a href="/admin/gazette/issues/<%= issue.id %>/edit" class="btn btn-xs btn-outline-primary" title="Редактировать">
                  <i class="fas fa-edit"></i>
                </a>
                <form action="/admin/gazette/issues/<%= issue.id %>/delete" method="POST"
                      onsubmit="return confirm('Удалить выпуск целиком, включая обложку и PDF?')">
                  <button type="submit" class="btn btn-xs btn-outline-danger" title="Удалить">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center p-5 text-muted">
      <i class="fas fa-newspaper fa-3x mb-3"></i>
      <p>Выпусков пока нет</p>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/admin-layout-bottom') %>
