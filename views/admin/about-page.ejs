<%
  locals.activePage = 'about-page';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title"><i class="fas fa-info-circle me-2"></i>Об организации — тексты</h2>
  <a href="/about" target="_blank" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-external-link-alt me-1"></i>Просмотр страницы
  </a>
</div>

<!-- Председатель -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0"><i class="fas fa-user-tie me-2"></i>Председатель (блок Съезда)</h5></div>
  <div class="admin-card-body">
    <% if (chairman) { %>
    <form action="/admin/about-page/chairman" method="POST" enctype="multipart/form-data">
      <div class="row g-3 align-items-start">
        <div class="col-md-2 text-center">
          <% if (chairman.photo) { %>
            <img src="<%= chairman.photo %>" class="rounded-circle mb-2" style="width:90px;height:90px;object-fit:cover">
          <% } else { %>
            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-2 mx-auto" style="width:90px;height:90px">
              <i class="fas fa-user text-white fa-2x"></i>
            </div>
          <% } %>
          <input type="file" name="photo" class="form-control form-control-sm" accept="image/*">
        </div>
        <div class="col-md-10">
          <div class="mb-2">
            <label class="form-label fw-medium">Имя</label>
            <input type="text" name="name" class="form-control" value="<%= chairman.name %>">
          </div>
          <div class="mb-2">
            <label class="form-label fw-medium">Должность</label>
            <input type="text" name="position" class="form-control" value="<%= chairman.position %>">
          </div>
          <div class="mb-2">
            <label class="form-label fw-medium">Биография</label>
            <textarea name="bio" class="form-control" rows="4"><%= chairman.bio || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-danger">
            <i class="fas fa-save me-1"></i>Сохранить
          </button>
        </div>
      </div>
    </form>
    <% } else { %>
    <p class="text-muted">Руководитель не найден. Добавьте через <a href="/admin/leaders">Руководство</a>.</p>
    <% } %>
  </div>
</div>

<!-- Текстовые блоки -->
<% sections.forEach(function(section) { %>
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h5 class="mb-0"><%= section.label %></h5>
  </div>
  <div class="admin-card-body">
    <form action="/admin/about-page/<%= section.key %>" method="POST">
      <div class="mb-3">
        <% if (section.single_line) { %>
          <input type="text" name="text" class="form-control" value="<%= texts[section.key] %>">
        <% } else { %>
          <textarea name="text" class="form-control font-monospace" rows="<%= section.key === 'about_history' ? 16 : 6 %>"
            placeholder="Разделяйте абзацы пустой строкой."><%= texts[section.key] %></textarea>
          <div class="form-text">Разделяйте абзацы пустой строкой.</div>
        <% } %>
      </div>
      <button type="submit" class="btn btn-danger">
        <i class="fas fa-save me-1"></i>Сохранить
      </button>
    </form>
  </div>
</div>
<% }); %>

<%- include('partials/admin-layout-bottom') %>
