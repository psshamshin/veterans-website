<%
  locals.activePage = 'history-leaders';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header mb-4">
  <h2 class="page-title"><i class="fas fa-users me-2"></i>Руководители организации в разные годы</h2>
</div>

<% leaders.forEach(function(leader) { %>
<div class="admin-card mb-4">
  <div class="admin-card-header">
    <h5 class="mb-0"><%= leader.name %> <span class="text-muted fw-normal fs-6"><%= leader.years %></span></h5>
  </div>
  <div class="admin-card-body">
    <div class="row align-items-center g-3">
      <div class="col-md-3">
        <% if (leader.photo) { %>
          <img src="<%= leader.photo %>" alt="" class="img-fluid rounded" style="width:100%;height:160px;object-fit:cover">
        <% } else { %>
          <div class="text-center p-3 bg-light rounded text-muted">
            <i class="fas fa-user fa-2x mb-1"></i>
            <p class="mb-0 small">Фото не загружено</p>
          </div>
        <% } %>
      </div>
      <div class="col-md-9">
        <p class="text-muted small mb-3"><%= leader.bio %></p>
        <form action="/admin/history-leaders/<%= leader.id %>/photo" method="POST" enctype="multipart/form-data" class="mb-2">
          <div class="input-group">
            <input type="file" name="photo" class="form-control form-control-sm" accept="image/*" required>
            <button type="submit" class="btn btn-danger btn-sm">
              <i class="fas fa-upload me-1"></i>Загрузить фото
            </button>
          </div>
        </form>
        <% if (leader.photo) { %>
        <form action="/admin/history-leaders/<%= leader.id %>/photo/delete" method="POST"
              onsubmit="return confirm('Удалить фото?')">
          <button type="submit" class="btn btn-outline-danger btn-sm">
            <i class="fas fa-trash me-1"></i>Удалить фото
          </button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% }); %>

<%- include('partials/admin-layout-bottom') %>
