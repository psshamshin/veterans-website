<%
  locals.activePage = 'gazette';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title"><i class="fas fa-newspaper me-2"></i>Редактировать выпуск</h2>
  <a href="/admin/gazette" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-arrow-left me-1"></i>Назад к выпускам
  </a>
</div>

<div class="admin-card">
  <div class="admin-card-body">
    <form action="/admin/gazette/issues/<%= issue.id %>/edit" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label fw-medium">Название выпуска</label>
        <input type="text" name="title" class="form-control" required value="<%= issue.title %>">
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <label class="form-label fw-medium">Обложка</label>
          <% if (issue.cover) { %>
          <div class="mb-2">
            <img src="<%= issue.cover %>" alt="" class="img-fluid rounded" style="max-height:200px">
          </div>
          <% } %>
          <input type="file" name="cover" class="form-control" accept="image/*">
          <div class="form-text">Оставьте пустым, чтобы не менять текущую обложку.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label fw-medium">Файл выпуска (PDF)</label>
          <% if (issue.file) { %>
          <div class="mb-2">
            <a href="<%= issue.file %>" target="_blank" class="btn btn-outline-secondary btn-sm">
              <i class="fas fa-eye me-1"></i>Текущий файл
            </a>
          </div>
          <% } %>
          <input type="file" name="file" class="form-control">
          <div class="form-text">Оставьте пустым, чтобы не менять текущий файл.</div>
        </div>
      </div>

      <button type="submit" class="btn btn-danger mt-4">
        <i class="fas fa-save me-1"></i>Сохранить
      </button>
    </form>
  </div>
</div>

<%- include('partials/admin-layout-bottom') %>
