<%
  locals.activePage = 'gazette';
  locals.flash_success = flash_success;
  locals.flash_error = flash_error;
%>
<%- include('partials/admin-layout-top') %>

<div class="page-header d-flex justify-content-between align-items-center mb-4">
  <h2 class="page-title"><i class="fas fa-newspaper me-2"></i><%= issue.title %></h2>
  <a href="/admin/gazette" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-arrow-left me-1"></i>Назад к выпускам
  </a>
</div>

<!-- Title -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0">Название выпуска</h5></div>
  <div class="admin-card-body">
    <form action="/admin/gazette/issues/<%= issue.id %>/edit" method="POST" class="row g-3 align-items-end">
      <div class="col-md-8">
        <input type="text" name="title" class="form-control" required value="<%= issue.title %>">
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary w-100">
          <i class="fas fa-save me-1"></i>Сохранить
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Downloadable file -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0"><i class="fas fa-file-pdf me-2"></i>Файл для скачивания</h5></div>
  <div class="admin-card-body">
    <% if (issue.file) { %>
    <div class="mb-3">
      <a href="<%= issue.file %>" target="_blank" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-eye me-1"></i>Текущий файл
      </a>
    </div>
    <% } %>
    <form action="/admin/gazette/issues/<%= issue.id %>/file" method="POST" enctype="multipart/form-data" class="row g-3 align-items-end">
      <div class="col-md-8">
        <label class="form-label fw-medium"><%= issue.file ? 'Заменить файл выпуска (PDF)' : 'Загрузить файл выпуска (PDF)' %></label>
        <input type="file" name="file" class="form-control" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-danger w-100">
          <i class="fas fa-upload me-1"></i>Загрузить
        </button>
      </div>
    </form>
    <% if (issue.file) { %>
    <form action="/admin/gazette/issues/<%= issue.id %>/file/delete" method="POST" class="mt-3"
          onsubmit="return confirm('Удалить файл?')">
      <button type="submit" class="btn btn-outline-danger btn-sm">
        <i class="fas fa-trash me-1"></i>Удалить файл
      </button>
    </form>
    <% } %>
  </div>
</div>

<!-- Upload photo -->
<div class="admin-card mb-4">
  <div class="admin-card-header"><h5 class="mb-0"><i class="fas fa-upload me-2"></i>Добавить страницу выпуска</h5></div>
  <div class="admin-card-body">
    <form action="/admin/gazette/issues/<%= issue.id %>/photos/new" method="POST" enctype="multipart/form-data" class="row g-3 align-items-end">
      <div class="col-md-8">
        <label class="form-label fw-medium">Фото страницы (верстка)</label>
        <input type="file" name="image" class="form-control" accept="image/*" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-danger w-100">
          <i class="fas fa-upload me-1"></i>Загрузить
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Photo grid -->
<div class="admin-card">
  <div class="admin-card-body">
    <% if (photos.length > 0) { %>
    <div class="row g-3">
      <% photos.forEach(p => { %>
      <div class="col-md-3 col-sm-4 col-6">
        <div class="position-relative">
          <img src="<%= p.image %>" alt="" class="img-fluid rounded" style="width:100%;height:160px;object-fit:cover">
          <form action="/admin/gazette/issues/<%= issue.id %>/photos/<%= p.id %>/delete" method="POST"
                onsubmit="return confirm('Удалить страницу?')"
                class="position-absolute top-0 end-0 m-1">
            <button type="submit" class="btn btn-xs btn-outline-danger bg-white">
              <i class="fas fa-trash"></i>
            </button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center p-5 text-muted">
      <i class="fas fa-images fa-3x mb-3"></i>
      <p>Страниц пока нет</p>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/admin-layout-bottom') %>
