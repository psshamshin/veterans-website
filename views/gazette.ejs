<%- include('partials/header') %>

<!-- Page Banner -->
<div class="page-banner">
  <div class="container">
    <h1 class="page-banner-title"><i class="fas fa-newspaper me-2"></i>Газета «Ветеран»</h1>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Главная</a></li>
        <li class="breadcrumb-item active">Газета «Ветеран»</li>
      </ol>
    </nav>
  </div>
</div>

<main class="py-5">
  <div class="container">

    <% if (issues.length > 0) { %>
    <div class="gazette-grid">
      <% issues.forEach(function(issue) { %>
      <div class="gazette-card">
        <div class="gazette-cover-wrap">
          <% if (issue.cover) { %>
          <img src="<%= issue.cover %>" alt="<%= issue.title %>" class="gazette-cover" loading="lazy">
          <% } else { %>
          <div class="gazette-cover-placeholder"><i class="fas fa-newspaper"></i></div>
          <% } %>
        </div>
        <div class="gazette-card-body">
          <div class="gazette-card-title"><%= issue.title %></div>
          <% if (issue.file) { %>
          <a href="<%= issue.file %>" download class="btn-gazette-download">
            <i class="fas fa-download me-2"></i>Скачать
          </a>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="empty-state">
      <i class="fas fa-newspaper fa-3x mb-3" style="color:var(--text-muted); opacity:0.4;"></i>
      <h4 style="color:var(--primary);">Номеров пока нет</h4>
      <p class="text-muted">Выпуски газеты появятся здесь после публикации через панель управления.</p>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>

<style>
.gazette-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 24px;
}
.gazette-card {
  background: #fff; border-radius: var(--radius);
  box-shadow: var(--shadow); overflow: hidden;
  border: 1px solid rgba(27,58,107,0.08);
  text-align: center;
  transition: transform var(--transition), box-shadow var(--transition);
}
.gazette-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.gazette-cover-wrap { aspect-ratio: 3/4; background: var(--bg); }
.gazette-cover { width: 100%; height: 100%; object-fit: cover; display: block; }
.gazette-cover-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: rgba(255,255,255,0.4); font-size: 2.4rem;
}
.gazette-card-body { padding: 16px; }
.gazette-card-title { font-size: 0.95rem; font-weight: 700; color: var(--primary); margin-bottom: 12px; }

.btn-gazette-download {
  display: inline-flex; align-items: center;
  padding: 9px 22px; border-radius: var(--radius-pill);
  background: var(--accent); color: #fff;
  font-size: 0.85rem; font-weight: 600; text-decoration: none;
  box-shadow: 0 4px 16px rgba(150,32,32,0.28);
  transition: background var(--transition), transform var(--transition), box-shadow var(--transition);
}
.btn-gazette-download:hover {
  background: var(--accent-dark); color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(150,32,32,0.32);
}
</style>
